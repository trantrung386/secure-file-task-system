# Thông tin ứng dụng
APP_NAME="TruTo Work"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/NgocToan_VanTrung_Web-app

# Cấu hình kết nối MySQL CSDL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=data
DB_USER=root
DB_PASS=
