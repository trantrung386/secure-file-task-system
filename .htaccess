# ==============================================================================
# Root .htaccess - Tường lửa và điều phối cho ứng dụng
# ==============================================================================

# 1. Tắt duyệt danh mục thư mục (Directory Browsing)
Options -Indexes -MultiViews

# 2. Thiết lập HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Chặn đứng truy cập vào các file nhạy cảm ở cấp thư mục gốc
<FilesMatch "(\.(git|env|rnd|sql|md|json|lock|log|bak|rar|zip)|\.htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Chặn truy cập trực tiếp các thư mục mã nguồn và dữ liệu
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chặn truy cập trực tiếp thư mục nội bộ
    RewriteRule ^(app|database|storage|docs|\.git|\.vscode)(/.*)?$ - [F,L]

    # Nếu truy cập assets ở root hoặc public/assets, cho phép phục vụ bình thường
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Điều hướng toàn bộ request còn lại vào public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
